Tabs.Quest:AddSection("🎯 Auto Quest")

local QuestToggle = Tabs.Quest:AddToggle("AutoQuest", {
    Title       = "Auto Quest",
    Description = "Tự nhận quest theo level mỗi 30 giây",
    Default     = false,
})
QuestToggle:OnChanged(function(v)
    State.autoQuest = v
    if v and State.farmEnabled then task.spawn(AcceptQuest) end
end)

Tabs.Quest:AddSlider("QuestInterval", {
    Title       = "Quest Interval (giây)",
    Description = "Tần suất tự nhận quest",
    Default     = 30,
    Min         = 10,
    Max         = 120,
    Rounding    = 5,
}):OnChanged(function(v) Cfg.questInterval = v end)

Tabs.Quest:AddButton({
    Title       = "Nhận Quest Ngay",
    Description = "Bay đến NPC và nhận quest phù hợp level",
    Callback    = function()
        if State.isFlyingQuest then
            Fluent:Notify({ Title = "Quest", Content = "Đang bay nhận quest rồi...", Duration = 2 })
            return
        end
        task.spawn(AcceptQuest)
    end,
})

-- =====================================================
-- TAB MISC
-- =====================================================
Tabs.Misc:AddSection("⚙ Cài Đặt")

Tabs.Misc:AddButton({
    Title    = "Force Reset",
    Description = "Reset nhân vật về trạng thái bình thường",
    Callback = function()
        State.farmEnabled = false
        State.isFlyingQuest = false
        ForceReset()
        Fluent:Notify({ Title = "Reset", Content = "Đã reset!", Duration = 2 })
    end,
})

SaveManager:SetLibrary(Fluent)
InterfaceManager:SetLibrary(Fluent)
InterfaceManager:SetFolder("Concuhub")
SaveManager:SetFolder("Concuhub/configs")
SaveManager:BuildConfigSection(Tabs.Misc)
InterfaceManager:BuildInterfaceSection(Tabs.Misc)

-- =====================================================
-- TAB INFO
-- =====================================================
Tabs.Info:AddSection("📊 Thông Tin")

local InfoParagraph = Tabs.Info:AddParagraph({
    Title   = "Nhân Vật",
    Content = "Đang tải...",
})

local StatusParagraph = Tabs.Info:AddParagraph({
    Title   = "Trạng Thái",
    Content = "Farm: OFF",
})

task.spawn(function()
    while true do
        task.wait(2)
        local lv   = getPlayerLevel()
        local data = getDataForLevel(lv)
        pcall(function()
            InfoParagraph:SetContent(
                "Level: "    .. lv            .. "\n" ..
                "Sea: "      .. data.sea      .. "\n" ..
                "Island: "   .. data.island   .. "\n" ..
                "Quest NPC: ".. data.questNPC .. "\n" ..
                "Mob: "      .. data.mobName  .. "\n" ..
                "Lv Range: " .. data.minLv .. " → " .. data.maxLv
            )
            StatusParagraph:SetContent(
                "Farm: "      .. (State.farmEnabled and "ON ✓" or "OFF") .. "\n" ..
                "AutoQuest: " .. (State.autoQuest and "ON ✓" or "OFF")   .. "\n" ..
                "BringMob: "  .. (State.bringMob and "ON ✓" or "OFF")    .. "\n" ..
                "Flying Quest: " .. (State.isFlyingQuest and "YES" or "NO") .. "\n" ..
                "Hash: "      .. lastHash
            )
        end)
    end
end)

Tabs.Info:AddButton({
    Title    = "Debug Info",
    Description = "In thông tin debug ra console",
    Callback = function()
        print("=== CONCUHUB DEBUG ===")
        print("Hash:", lastHash)
        print("Attack Remote:", AttackRemote:GetFullName())
        print("Quest Remote:", QuestRemote:GetFullName())
        print("Farm:", State.farmEnabled)
        print("Scan Range:", Cfg.scanRange)
        print("Attack Range:", Cfg.attackRange)
        print("======================")
    end,
})

-- ── Load config ──
SaveManager:LoadAutoloadConfig()
Window:SelectTab(1)

Fluent:Notify({
    Title    = "Concuhub v2.0",
    Content  = "Loaded! Bật Auto Farm để bắt đầu.",
    Duration = 5,
})

print("[Concuhub v2.0] Loaded OK")
print("[Concuhub] Hash hiện tại:", lastHash)
 
