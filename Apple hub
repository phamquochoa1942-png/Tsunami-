-- FIX DAME: Hook AttackRemote để tự lấy hash mới nhất
-- Mỗi lần game gốc fire → ta lấy args đó dùng lại
local lastArgs = {nil, {}, [4] = "079996f9"}

pcall(function()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and self == AttackRemote then
            lastArgs = {...}  -- Lưu args mới nhất từ game gốc
        end
        return oldIndex(self, ...)
    end)
    setreadonly(mt, true)
end)

