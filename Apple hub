-- Tìm data phù hợp với level hiện tại
local function getDataForLevel(level)
    for _, data in ipairs(LevelData) do
        if level >= data[1] and level < data[2] then
            return {
                minLv      = data[1],
                maxLv      = data[2],
                sea        = data[3],
                island     = data[4],
                questNPC   = data[5],
                mobFolder  = data[6],
                mobName    = data[7],
            }
        end
    end
    return LevelData[#LevelData]
end

local function getPlayerLevel()
    local Char = LocalPlayer.Character
    if not Char then return 1 end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    -- Blox Fruits lưu level trong leaderstats
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local lv = stats:FindFirstChild("Level") or stats:FindFirstChild("Lv")
        if lv then return lv.Value end
    end
    return 1
end

