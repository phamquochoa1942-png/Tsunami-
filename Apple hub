-- =====================================================
-- CORE
-- =====================================================
local function ForceReset()
    State.isActive      = false
    State.currentTarget = nil

    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end

    workspace.Gravity = State.origGravity
    UserInputService.MouseIconEnabled = true

    local Char = LocalPlayer.Character
    if not Char then return end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    if Hum then
        Hum.WalkSpeed     = State.origWalk
        Hum.JumpPower     = State.origJump
        Hum.PlatformStand = false
        Hum.AutoRotate    = true
    end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if Root then
        Root.Velocity                = Vector3.new(0,0,0)
        Root.RotVelocity             = Vector3.new(0,0,0)
        Root.AssemblyLinearVelocity  = Vector3.new(0,0,0)
        Root.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end
    for _, p in ipairs(Char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

local function StartNoFall(Target)
    if State.noFallConn then
        State.noFallConn:Disconnect()
    end

    workspace.Gravity = 0
    UserInputService.MouseIconEnabled = false

    local Char = LocalPlayer.Character
    if Char then
        local Hum = Char:FindFirstChildOfClass("Humanoid")
        if Hum then
            State.origWalk    = Hum.WalkSpeed
            State.origJump    = Hum.JumpPower
            Hum.WalkSpeed     = 0
            Hum.JumpPower     = 0
            Hum.PlatformStand = true
            Hum.AutoRotate    = false
        end
        for _, p in ipairs(Char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.CanCollide = false
            end
        end
    end

    State.noFallConn = RunService.RenderStepped:Connect(function()
        if not State.isActive then return end
        local C = LocalPlayer.Character
        if not C or not Target or not Target.Parent then return end
        local Root = C:FindFirstChild("HumanoidRootPart")
        local ER   = Target:FindFirstChild("HumanoidRootPart")
        if not Root or not ER then return end
        Root.CFrame                  = ER.CFrame * CFrame.new(0, 10, 0)
        Root.Velocity                = Vector3.new(0,0,0)
        Root.RotVelocity             = Vector3.new(0,0,0)
        Root.AssemblyLinearVelocity  = Vector3.new(0,0,0)
        Root.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end)
end

-- Bay đến vị trí bằng TweenService
local function FlyTo(pos, duration)
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    workspace.Gravity = 0
    local Tween = TweenService:Create(Root,
        TweenInfo.new(duration or 1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {CFrame = CFrame.new(pos)}
    )
    Tween:Play()
    Tween.Completed:Wait()
end

-- Bring Mob: kéo mob về gần nhân vật
local function BringMobs()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return end

    for _, Enemy in ipairs(Enemies:GetChildren()) do
        if not Enemy:IsA("Model") then continue end
        local EH = Enemy:FindFirstChildOfClass("Humanoid")
        local ER = Enemy:FindFirstChild("HumanoidRootPart")
        if not EH or EH.Health <= 0 or not ER then continue end
        local dist = (Root.Position - ER.Position).Magnitude
        if dist <= 500 then
            ER.CFrame = Root.CFrame * CFrame.new(
                math.random(-6,6), 0, math.random(-6,6)
            )
        end
    end
end

-- Auto Quest: bay đến NPC → nhận quest
local function AcceptQuest()
    local lv   = getPlayerLevel()
    local data = getDataForLevel(lv)

    -- Tìm NPC trong workspace
    local npcRoot = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name:find(data.questNPC) then
            local r = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
            if r then npcRoot = r; break end
        end
    end

    if npcRoot then
        -- Tắt nofall để bay tự do
        local wasActive = State.isActive
        if State.noFallConn then
            State.noFallConn:Disconnect()
            State.noFallConn = nil
        end

        FlyTo(npcRoot.Position + Vector3.new(0, 3, -5), 2)
        task.wait(0.5)

        pcall(function()
            QuestRemote:FireServer(data.questNPC, data.island)
        end)

        print("[Concuhub] Quest nhận:", data.questNPC, "Lv", lv)

        -- Bật lại nofall nếu đang farm
        if wasActive and State.currentTarget and State.currentTarget.Parent then
            State.isActive = true
            StartNoFall(State.currentTarget)
        end
    else
        warn("[Concuhub] Không tìm thấy NPC:", data.questNPC)
    end
end

