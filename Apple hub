-- AUTO QUEST — FIX: tìm NPC bằng nhiều cách
-- =====================================================
local function AcceptQuest()
    if State.isFlyingQuest then return end
    State.isFlyingQuest = true

    local lv   = getPlayerLevel()
    local data = getDataForLevel(lv)
    print("[Concuhub] Tìm NPC quest:", data.questNPC, "| Lv:", lv)

    -- Tìm NPC bằng nhiều cách
    local npcPos = nil

    -- Cách 1: Tìm Model tên chứa questNPC
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") then
            if v.Name:lower():find(data.questNPC:lower()) then
                local r = v:FindFirstChild("HumanoidRootPart")
                    or v:FindFirstChild("Root")
                    or v.PrimaryPart
                if r then
                    npcPos = r.Position
                    print("[Concuhub] Tìm thấy NPC Model:", v.Name)
                    break
                end
            end
        end
    end

    -- Cách 2: Tìm Part/BasePart tên chứa questNPC
    if not npcPos then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name:lower():find(data.questNPC:lower()) then
                npcPos = v.Position
                print("[Concuhub] Tìm thấy NPC Part:", v.Name)
                break
            end
        end
    end

    if npcPos then
        -- Bay đến NPC
        FlyTo(npcPos + Vector3.new(0, 3, -5), 2)
        task.wait(0.8)

        -- Fire quest remote
        pcall(function()
            QuestRemote:FireServer(data.questNPC, data.island)
            print("[Concuhub] FireServer quest:", data.questNPC)
        end)

        task.wait(0.5)
        Fluent:Notify({
            Title   = "Quest",
            Content = "Nhận quest: " .. data.questNPC,
            Duration = 3,
        })
    else
        warn("[Concuhub] Không tìm thấy NPC:", data.questNPC)
        Fluent:Notify({
            Title   = "Quest",
            Content = "Không tìm thấy NPC: " .. data.questNPC,
            Duration = 3,
        })
    end

    -- Bật lại farm sau khi quest xong
    if State.farmEnabled and State.currentTarget and State.currentTarget.Parent then
        State.isActive = true
        StartNoFall(State.currentTarget)
    else
        -- Reset để main loop tìm mob mới
        State.isActive      = false
        State.currentTarget = nil
        workspace.Gravity   = State.origGravity
    end

    State.isFlyingQuest = false
end

-- =====================================================
-- SCAN MOB XA — quét toàn bộ map tìm đàn tiếp theo
-- =====================================================
local function findNearestMob(fromPos, maxDist)
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return nil, math.huge end

    local closest = nil
    local closestDist = maxDist or math.huge

    for _, Enemy in ipairs(Enemies:GetChildren()) do
        if not Enemy:IsA("Model") then continue end
        local EH = Enemy:FindFirstChildOfClass("Humanoid")
        local ER = Enemy:FindFirstChild("HumanoidRootPart")
        if not EH or EH.Health <= 0 or not ER then continue end
        local dist = (fromPos - ER.Position).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest     = Enemy
        end
    end

    return closest, closestDist
end

-- Bay đến đàn mob tiếp theo khi đàn hiện tại hết
local function FlyToNextGroup()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    print("[Concuhub] Tìm đàn mob tiếp theo trong", Cfg.scanRange, "studs...")

    local nextMob, dist = findNearestMob(Root.Position, Cfg.scanRange)
    if nextMob then
        local ER = nextMob:FindFirstChild("HumanoidRootPart")
        if ER then
            print("[Concuhub] Bay đến đàn mới:", nextMob.Name, "cách", math.floor(dist), "studs")
            Fluent:Notify({
                Title   = "Farm",
                Content = "Bay đến đàn mới: " .. nextMob.Name,
                Duration = 2,
            })
            FlyTo(ER.Position + Vector3.new(0, 10, 0), math.clamp(dist/200, 0.5, 4))
            State.isActive      = true
            State.currentTarget = nextMob
            StartNoFall(nextMob)
        end
    else
        print("[Concuhub] Không tìm thấy mob trong", Cfg.scanRange, "studs")
    end
end

