-- Main farm loop
task.spawn(function()
    while true do
        task.wait()

        if not State.farmEnabled then
            if State.isActive then ForceReset() end
            continue
        end

        local Char = LocalPlayer.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")
        local Hum  = Char and Char:FindFirstChildOfClass("Humanoid")

        if not Char or not Root or not Hum or Hum.Health <= 0 then
            if State.isActive then ForceReset() end
            task.wait(0.2); continue
        end

        local Enemies = workspace:FindFirstChild("Enemies")
        if not Enemies then
            if State.isActive then ForceReset() end
            task.wait(0.2); continue
        end

        local Closest  = nil
        local ClostDist = 200
        local AllNearby = {}

        for _, Enemy in ipairs(Enemies:GetChildren()) do
            if not State.farmEnabled then break end
            if not Enemy:IsA("Model") then continue end
            local EH = Enemy:FindFirstChildOfClass("Humanoid")
            local ER = Enemy:FindFirstChild("HumanoidRootPart")
            if not EH or EH.Health <= 0 or not ER then continue end
            local dist = (Root.Position - ER.Position).Magnitude
            if dist <= 200 then
                table.insert(AllNearby, Enemy)
                if dist < ClostDist then
                    ClostDist = dist
                    Closest   = Enemy
                end
            end
        end

        if Closest then
            if not State.isActive then
                State.isActive      = true
                State.currentTarget = Closest
                StartNoFall(Closest)
            end

            -- Cập nhật target khi mob chết
            if State.currentTarget then
                local EH = State.currentTarget:FindFirstChildOfClass("Humanoid")
                local ER = State.currentTarget:FindFirstChild("HumanoidRootPart")
                if not EH or EH.Health <= 0 or not ER then
                    State.currentTarget = Closest
                    StartNoFall(Closest)
                end
            end

            -- FireServer mỗi mob trong 150 studs
            for _, Enemy in ipairs(AllNearby) do
                if not State.farmEnabled then break end
                local EH = Enemy:FindFirstChildOfClass("Humanoid")
                local ER = Enemy:FindFirstChild("HumanoidRootPart")
                if not EH or EH.Health <= 0 or not ER then continue end
                if (Root.Position - ER.Position).Magnitude > 150 then continue end

                local TargetPart = Enemy:FindFirstChild("LeftLowerArm")
                    or Enemy:FindFirstChild("RightLowerArm")
                    or Enemy:FindFirstChild("LeftFoot")
                    or Enemy:FindFirstChild("RightFoot")
                    or Enemy:FindFirstChild("Head") or ER

                -- Dùng lastArgs để lấy hash mới nhất từ hook
                -- Nếu hook không hoạt động thì fallback về args cũ
                local args = {TargetPart, {}, [4] = lastArgs[4] or "079996f9"}
                pcall(function()
                    AttackRemote:FireServer(unpack(args))
                end)
            end
        else
            if State.isActive then ForceReset() end
        end
    end
end)

