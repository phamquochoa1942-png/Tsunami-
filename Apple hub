-- =====================================================
-- CORE FUNCTIONS
-- =====================================================
local function ForceReset()
    State.isActive      = false
    State.currentTarget = nil

    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end

    workspace.Gravity = State.origGravity
    UserInputService.MouseIconEnabled = true

    local Char = LocalPlayer.Character
    if not Char then return end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    if Hum then
        Hum.WalkSpeed     = State.origWalk
        Hum.JumpPower     = State.origJump
        Hum.PlatformStand = false
        Hum.AutoRotate    = true
    end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if Root then
        Root.Velocity                = Vector3.new(0,0,0)
        Root.RotVelocity             = Vector3.new(0,0,0)
        Root.AssemblyLinearVelocity  = Vector3.new(0,0,0)
        Root.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end
    for _, p in ipairs(Char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

local function LockChar()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    if Hum then
        State.origWalk    = Hum.WalkSpeed
        State.origJump    = Hum.JumpPower
        Hum.WalkSpeed     = 0
        Hum.JumpPower     = 0
        Hum.PlatformStand = true
        Hum.AutoRotate    = false
    end
    for _, p in ipairs(Char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = false
        end
    end
    UserInputService.MouseIconEnabled = false
end

local function StartNoFall(Target)
    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end

    workspace.Gravity = 0
    LockChar()

    State.noFallConn = RunService.RenderStepped:Connect(function()
        if not State.isActive then return end
        local C = LocalPlayer.Character
        if not C or not Target or not Target.Parent then return end
        local Root = C:FindFirstChild("HumanoidRootPart")
        local ER   = Target:FindFirstChild("HumanoidRootPart")
        if not Root or not ER then return end

        -- Kiểm tra mob còn sống
        local EH = Target:FindFirstChildOfClass("Humanoid")
        if not EH or EH.Health <= 0 then return end

        Root.CFrame                  = ER.CFrame * CFrame.new(0, 10, 0)
        Root.Velocity                = Vector3.new(0,0,0)
        Root.RotVelocity             = Vector3.new(0,0,0)
        Root.AssemblyLinearVelocity  = Vector3.new(0,0,0)
        Root.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end)
end

-- FlyTo: Bay đến vị trí bằng CFrame trực tiếp (không dùng Tween vì hay bị kẹt)
local function FlyTo(targetPos, duration)
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    -- Tạm tắt NoFall trong lúc bay
    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end

    workspace.Gravity = 0
    LockChar()

    local startPos  = Root.Position
    local elapsed   = 0
    local totalTime = duration or 2
    local conn

    conn = RunService.RenderStepped:Connect(function(dt)
        elapsed = elapsed + dt
        local alpha = math.clamp(elapsed / totalTime, 0, 1)
        -- Ease out quad
        alpha = 1 - (1 - alpha)^2

        local Char2 = LocalPlayer.Character
        if not Char2 then conn:Disconnect(); return end
        local Root2 = Char2:FindFirstChild("HumanoidRootPart")
        if not Root2 then conn:Disconnect(); return end

        Root2.CFrame                 = CFrame.new(startPos:Lerp(targetPos, alpha))
        Root2.Velocity               = Vector3.new(0,0,0)
        Root2.AssemblyLinearVelocity = Vector3.new(0,0,0)

        if alpha >= 1 then conn:Disconnect() end
    end)

    -- Chờ bay xong
    local waited = 0
    repeat task.wait(0.05); waited += 0.05 until waited >= totalTime + 0.1
end

-- =====================================================
-- BRING MOB — FIX: dùng CFrame.new thay vì gán trực tiếp
-- =====================================================
local function BringMobs()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then
        warn("[Concuhub] Không tìm thấy folder Enemies")
        return
    end

    local count = 0
    for _, Enemy in ipairs(Enemies:GetChildren()) do
        if not Enemy:IsA("Model") then continue end
        local EH = Enemy:FindFirstChildOfClass("Humanoid")
        local ER = Enemy:FindFirstChild("HumanoidRootPart")
        if not EH or EH.Health <= 0 or not ER then continue end

        local dist = (Root.Position - ER.Position).Magnitude
        if dist <= Cfg.bringRange then
            -- FIX: dùng pcall để tránh crash khi set CFrame của mob
            pcall(function()
                ER.CFrame = CFrame.new(
                    Root.Position + Vector3.new(
                        math.random(-8, 8),
                        0,
                        math.random(-8, 8)
                    )
                )
            end)
            count += 1
        end
    end
    print("[Concuhub] Brought", count, "mobs")
end

