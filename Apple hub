-- Toggle card
local function makeToggle(parent, title, subtitle, default, callback)
    local Card = Instance.new("Frame")
    Card.Size             = UDim2.new(1, 0, 0, 58)
    Card.BackgroundColor3 = C.card
    Card.BorderSizePixel  = 0
    Card.Parent           = parent
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 10)

    local TitleL = Instance.new("TextLabel")
    TitleL.Text              = title
    TitleL.Size              = UDim2.new(1, -70, 0, 22)
    TitleL.Position          = UDim2.new(0, 14, 0, 8)
    TitleL.BackgroundTransparency = 1
    TitleL.TextColor3        = C.text
    TitleL.TextSize          = 13
    TitleL.Font              = Enum.Font.GothamBold
    TitleL.TextXAlignment    = Enum.TextXAlignment.Left
    TitleL.Parent            = Card

    local SubL = Instance.new("TextLabel")
    SubL.Text              = subtitle
    SubL.Size              = UDim2.new(1, -70, 0, 16)
    SubL.Position          = UDim2.new(0, 14, 0, 30)
    SubL.BackgroundTransparency = 1
    SubL.TextColor3        = C.subtext
    SubL.TextSize          = 10
    SubL.Font              = Enum.Font.Gotham
    SubL.TextXAlignment    = Enum.TextXAlignment.Left
    SubL.Parent            = Card

    -- Toggle track
    local Track = Instance.new("Frame")
    Track.Size             = UDim2.new(0, 40, 0, 22)
    Track.Position         = UDim2.new(1, -54, 0.5, -11)
    Track.BackgroundColor3 = default and C.toggle_on or C.toggle_off
    Track.BorderSizePixel  = 0
    Track.Parent           = Card
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size             = UDim2.new(0, 16, 0, 16)
    Knob.Position         = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    Knob.BackgroundColor3 = C.white
    Knob.BorderSizePixel  = 0
    Knob.Parent           = Track
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local state = default or false

    local Btn = Instance.new("TextButton")
    Btn.Size                  = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text                  = ""
    Btn.Parent                = Card

    Btn.MouseButton1Click:Connect(function()
        state = not state
        makeTween(Track, {BackgroundColor3 = state and C.toggle_on or C.toggle_off})
        makeTween(Knob, {Position = state
            and UDim2.new(1, -19, 0.5, -8)
            or  UDim2.new(0, 3,   0.5, -8)
        })
        callback(state)
    end)

    return Card
end

-- Section label
local function makeSection(parent, text)
    local L = Instance.new("TextLabel")
    L.Text              = text:upper()
    L.Size              = UDim2.new(1, 0, 0, 20)
    L.BackgroundTransparency = 1
    L.TextColor3        = C.pink
    L.TextSize          = 10
    L.Font              = Enum.Font.GothamBold
    L.TextXAlignment    = Enum.TextXAlignment.Left
    L.Parent            = parent
    return L
end

-- ── Tab system ──
local tabs      = {}
local tabFrames = {}
local activeTab = nil

local function makeTab(name)
    local Btn = Instance.new("TextButton")
    Btn.Text              = name
    Btn.Size              = UDim2.new(0, 80, 1, -8)
    Btn.BackgroundColor3  = C.card
    Btn.TextColor3        = C.subtext
    Btn.TextSize          = 11
    Btn.Font              = Enum.Font.GothamBold
    Btn.BorderSizePixel   = 0
    Btn.Parent            = TabBar
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

    local Frame = Instance.new("Frame")
    Frame.Size               = UDim2.new(1, 0, 1, 0)
    Frame.BackgroundTransparency = 1
    Frame.Visible            = false
    Frame.Parent             = Content

    local FLayout = Instance.new("UIListLayout")
    FLayout.Padding = UDim.new(0, 8)
    FLayout.Parent  = Frame

    local FPad = Instance.new("UIPadding")
    FPad.PaddingBottom = UDim.new(0, 8)
    FPad.Parent        = Frame

    Btn.MouseButton1Click:Connect(function()
        if activeTab then
            makeTween(tabs[activeTab].btn, {BackgroundColor3 = C.card, TextColor3 = C.subtext})
            tabFrames[activeTab].Visible = false
        end
        activeTab = name
        makeTween(Btn, {BackgroundColor3 = C.pink, TextColor3 = C.white})
        Frame.Visible = true
    end)

    tabs[name]      = {btn = Btn}
    tabFrames[name] = Frame
    return Frame
end

