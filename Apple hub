local function getDataForLevel(level)
    for i = #LevelData, 1, -1 do
        local d = LevelData[i]
        if level >= d[1] then return {
            minLv=d[1], maxLv=d[2], sea=d[3],
            island=d[4], questNPC=d[5], mobName=d[6]
        } end
    end
    return {minLv=1,maxLv=15,sea=1,island="StartIsland",questNPC="Villager1",mobName="Bandit"}
end

local function getPlayerLevel()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local lv = stats:FindFirstChild("Level") or stats:FindFirstChild("Lv")
        if lv then return tonumber(lv.Value) or 1 end
    end
    return 1
end

