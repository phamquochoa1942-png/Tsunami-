-- =====================================================
-- CORE FUNCTIONS
-- =====================================================
local function ForceReset()
    State.isActive      = false
    State.currentTarget = nil

    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end

    workspace.Gravity = State.originalGravity
    UserInputService.MouseIconEnabled = true

    local Char = LocalPlayer.Character
    if Char then
        local Hum = Char:FindFirstChildOfClass("Humanoid")
        if Hum then
            Hum.WalkSpeed     = State.originalWalkSpeed
            Hum.JumpPower     = State.originalJumpPower
            Hum.PlatformStand = false
            Hum.AutoRotate    = true
        end
        local Root = Char:FindFirstChild("HumanoidRootPart")
        if Root then
            Root.Velocity                = Vector3.new(0,0,0)
            Root.RotVelocity             = Vector3.new(0,0,0)
            Root.AssemblyLinearVelocity  = Vector3.new(0,0,0)
            Root.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
        for _, Part in ipairs(Char:GetDescendants()) do
            if Part:IsA("BasePart") then Part.CanCollide = true end
        end
    end
end

local function StartNoFall(Target)
    if State.noFallConn then
        State.noFallConn:Disconnect()
    end

    workspace.Gravity = 0
    UserInputService.MouseIconEnabled = false

    local Char = LocalPlayer.Character
    if Char then
        local Hum = Char:FindFirstChildOfClass("Humanoid")
        if Hum then
            State.originalWalkSpeed = Hum.WalkSpeed
            State.originalJumpPower = Hum.JumpPower
            Hum.WalkSpeed           = 0
            Hum.JumpPower           = 0
            Hum.PlatformStand       = true
            Hum.AutoRotate          = false
        end
        for _, Part in ipairs(Char:GetDescendants()) do
            if Part:IsA("BasePart") and Part.Name ~= "HumanoidRootPart" then
                Part.CanCollide = false
            end
        end
    end

    State.noFallConn = RunService.RenderStepped:Connect(function()
        if not State.isActive then return end
        local C = LocalPlayer.Character
        if C and Target and Target.Parent then
            local Root      = C:FindFirstChild("HumanoidRootPart")
            local EnemyRoot = Target:FindFirstChild("HumanoidRootPart")
            if Root and EnemyRoot then
                Root.CFrame                  = EnemyRoot.CFrame * CFrame.new(0, 10, 0)
                Root.Velocity                = Vector3.new(0,0,0)
                Root.RotVelocity             = Vector3.new(0,0,0)
                Root.AssemblyLinearVelocity  = Vector3.new(0,0,0)
                Root.AssemblyAngularVelocity = Vector3.new(0,0,0)
            end
        end
    end)
end

-- Tween bay đến vị trí
local function TweenTo(targetCFrame, duration)
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    local Tween = TweenService:Create(
        Root,
        TweenInfo.new(duration or 1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {CFrame = targetCFrame}
    )
    Tween:Play()
    Tween.Completed:Wait()
end

-- Bring Mob: kéo tất cả mob về phía nhân vật
local function BringMobs()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return end

    for _, Enemy in ipairs(Enemies:GetChildren()) do
        if not Enemy:IsA("Model") then continue end
        local EnemyHum  = Enemy:FindFirstChildOfClass("Humanoid")
        local EnemyRoot = Enemy:FindFirstChild("HumanoidRootPart")
        if not EnemyHum or EnemyHum.Health <= 0 or not EnemyRoot then continue end

        local Dist = (Root.Position - EnemyRoot.Position).Magnitude
        if Dist <= 300 then
            -- Kéo mob về gần nhân vật
            EnemyRoot.CFrame = Root.CFrame * CFrame.new(
                math.random(-8, 8), 0, math.random(-8, 8)
            )
        end
    end
end

-- Auto Quest: tìm NPC quest theo level rồi nhận
local function AcceptQuest()
    local level   = getPlayerLevel()
    local data    = getDataForLevel(level)
    if not data then return end

    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    -- Tìm NPC quest trong workspace
    local questNPC = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name:find(data.questNPC) then
            questNPC = v
            break
        end
    end

    if questNPC then
        local npcRoot = questNPC:FindFirstChild("HumanoidRootPart")
            or questNPC:FindFirstChild("PrimaryPart")
        if npcRoot then
            -- Bay đến NPC
            TweenTo(npcRoot.CFrame * CFrame.new(0, 0, -5), 1.5)
            task.wait(0.5)
            -- Fire quest remote nếu có
            if QuestRemote then
                pcall(function()
                    QuestRemote:FireServer(data.questNPC)
                end)
            end
            print("[Concuhub] Nhận quest:", data.questNPC, "| Level:", level)
        end
    end
end

