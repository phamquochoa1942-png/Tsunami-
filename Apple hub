-- =====================================================
local function getChar()
    local c = LocalPlayer.Character
    if not c then return nil, nil, nil end
    local r = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    return c, r, h
end

local function resetChar()
    State.active = false
    State.target = nil
    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end
    workspace.Gravity = State.origGravity
    local c, r, h = getChar()
    if not c then return end
    if h then
        h.WalkSpeed     = State.origWalk
        h.JumpPower     = State.origJump
        h.PlatformStand = false
        h.AutoRotate    = true
    end
    if r then
        r.Velocity                = Vector3.zero
        r.RotVelocity             = Vector3.zero
        r.AssemblyLinearVelocity  = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

local function lockChar()
    local c, r, h = getChar()
    if not c then return end
    if h then
        State.origWalk    = h.WalkSpeed
        State.origJump    = h.JumpPower
        h.WalkSpeed       = 0
        h.JumpPower       = 0
        h.PlatformStand   = true
        h.AutoRotate      = false
    end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = false
        end
    end
end

-- =====================================================
-- NOFALL
-- =====================================================
local function startNoFall(mob)
    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end
    workspace.Gravity = 0
    lockChar()

    State.noFallConn = RunService.RenderStepped:Connect(function()
        if not State.active then return end
        local _, r = getChar()
        if not r or not mob or not mob.Parent then return end
        local er = mob:FindFirstChild("HumanoidRootPart")
        local eh = mob:FindFirstChildOfClass("Humanoid")
        if not er or not eh or eh.Health <= 0 then return end
        r.CFrame                  = er.CFrame * CFrame.new(0, 10, 0)
        r.Velocity                = Vector3.zero
        r.RotVelocity             = Vector3.zero
        r.AssemblyLinearVelocity  = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- =====================================================
-- FLY TO
-- =====================================================
local function flyTo(targetPos, speed)
    speed = speed or 150
    if State.noFallConn then
        State.noFallConn:Disconnect()
        State.noFallConn = nil
    end
    workspace.Gravity = 0
    lockChar()

    local done = false
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        local _, r = getChar()
        if not r then conn:Disconnect(); done = true; return end
        local diff = targetPos - r.Position
        if diff.Magnitude < 3 then
            r.CFrame                  = CFrame.new(targetPos)
            r.Velocity                = Vector3.zero
            r.AssemblyLinearVelocity  = Vector3.zero
            conn:Disconnect(); done = true; return
        end
        local step = math.min(speed * dt, diff.Magnitude)
        r.CFrame                  = CFrame.new(r.Position + diff.Unit * step)
        r.Velocity                = Vector3.zero
        r.AssemblyLinearVelocity  = Vector3.zero
    end)

    local t = 0
    repeat task.wait(0.05); t += 0.05 until done or t >= 10
end

-- =====================================================
-- FIND MOB
-- =====================================================
local function findMobs(fromPos, maxDist)
    local closest, closestDist = nil, maxDist or math.huge
    local nearby = {}
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return nil, math.huge, {} end

    for _, e in ipairs(Enemies:GetChildren()) do
        if not e:IsA("Model") then continue end
        local eh = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health <= 0 or not er then continue end
        local dist = (fromPos - er.Position).Magnitude
        if dist <= (maxDist or math.huge) then
            table.insert(nearby, {mob=e, dist=dist})
            if dist < closestDist then
                closestDist = dist
                closest = e
            end
        end
    end
    return closest, closestDist, nearby
end

-- =====================================================
-- BRING MOB
-- =====================================================
local function bringMobs()
    local _, r = getChar()
    if not r then return end
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return end

    local count = 0
    for _, e in ipairs(Enemies:GetChildren()) do
        if not e:IsA("Model") then continue end
        local eh = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health <= 0 or not er then continue end
        local dist = (r.Position - er.Position).Magnitude
        if dist <= Cfg.bringRange then
            pcall(function()
                er.CFrame = r.CFrame * CFrame.new(math.random(-5,5), 0, math.random(-8,-3))
                er.Velocity = Vector3.zero
                er.AssemblyLinearVelocity = Vector3.zero
            end)
            count += 1
        end
    end
end

-- =====================================================
-- AUTO QUEST
-- =====================================================
local function acceptQuest()
    if State.questBusy then return end
    State.questBusy = true

    local lv   = getPlayerLevel()
    local data = getDataForLevel(lv)

    local _, r = getChar()

    local questNPC = nil
    local questHRP = nil

    local npcsFolder = workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, npc in ipairs(npcsFolder:GetChildren()) do
            if npc:IsA("Model") and npc.Name:lower():find(data.questNPC:lower()) then
                questNPC = npc
                questHRP = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
                break
            end
        end
    end

    if not questNPC then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v.Name:lower():find(data.questNPC:lower()) then
                questNPC = v
                questHRP = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
                break
            end
        end
    end

    if questHRP then
        flyTo(questHRP.Position + Vector3.new(0, 3, -5), 200)
        task.wait(0.5)
    end

    pcall(function()
        if QuestRemote then
            QuestRemote:FireServer(data.questNPC, data.island, data.mobName)
        end
    end)

    task.wait(0.5)

    if State.farm then
        if State.target and State.target.Parent then
            State.active = true
            startNoFall(State.target)
        else
            State.active = false
            State.target = nil
            workspace.Gravity = State.origGravity
        end
    end

    State.questBusy = false
end

-- =====================================================
-- ATTACK
-- =====================================================
local function attackEnemy(mob)
    if not AttackRemote then return end
    local eh = mob:FindFirstChildOfClass("Humanoid")
    local er = mob:FindFirstChild("HumanoidRootPart")
    if not eh or eh.Health <= 0 or not er then return end

    local targetPart = mob:FindFirstChild("LeftLowerArm")
        or mob:FindFirstChild("RightLowerArm")
        or mob:FindFirstChild("LeftFoot")
        or mob:FindFirstChild("RightFoot")
        or mob:FindFirstChild("Head")
        or er

    pcall(function()
        AttackRemote:FireServer(targetPart, {}, "079996f9")
    end)
end

-- =====================================================
-- MAIN FARM LOOP
-- =====================================================
task.spawn(function()
    while true do
        task.wait()
        if not State.farm or State.questBusy then
            if State.active and not State.questBusy then resetChar() end
            continue
        end

        local c, r, h = getChar()
        if not c or not r or not h or h.Health <= 0 then
            if State.active then resetChar() end
            task.wait(0.2); continue
        end

        local closest, closestDist, nearby = findMobs(r.Position, Cfg.scanRange)

        local inRange = {}
        for _, item in ipairs(nearby) do
            if item.dist <= Cfg.attackRange then
                table.insert(inRange, item.mob)
            end
        end

        if closest then
            if not State.active then
                State.active = true
                State.target = closest
                startNoFall(closest)
            end

            if State.target then
                local teh = State.target:FindFirstChildOfClass("Humanoid")
                if not teh or teh.Health <= 0 or not State.target.Parent then
                    State.target = closest
                    startNoFall(closest)
                end
            end

            for _, mob in ipairs(inRange) do
                if not State.farm then break end
                attackEnemy(mob)
            end

            VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,1)
            VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,1)
        else
            if State.active then
                resetChar()
                task.wait(0.3)
            end
            if State.farm and not State.questBusy then
                local c2, r2 = getChar()
                if r2 then
                    local nextMob, dist2 = findMobs(r2.Position, Cfg.scanRange)
                    if nextMob then
                        local er2 = nextMob:FindFirstChild("HumanoidRootPart")
                        if er2 then
                            State.active = false
                            flyTo(er2.Position + Vector3.new(0, 10, 0), 300)
                            State.active = true
                            State.target = nextMob
                            startNoFall(nextMob)
                        end
                    end
                end
            end
        end
    end
end)

-- Bring mob loop
task.spawn(function()
